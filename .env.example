# Postgres (Neon works great — free tier, one-click Vercel integration).
# DATABASE_URL: the pooled connection string, used at request time.
# DIRECT_URL: the non-pooled connection string, used only for migrations
# (PgBouncer's transaction pooling mode doesn't support what `migrate deploy`
# needs). Neon's dashboard gives you both — see README.
DATABASE_URL="postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=require"
DIRECT_URL="postgresql://user:password@host.region.aws.neon.tech/dbname?sslmode=require"

# NextAuth
# Generate with: npx auth secret   (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3005"

# Web Push (VAPID). Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:you@example.com"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""

# Shared secret required by /api/cron/eod-sweep, /api/cron/reminders, and
# the local worker. Also set as a GitHub Actions repo secret in production
# (see .github/workflows/cron.yml).
CRON_SECRET="replace-with-a-random-secret"

# Email (Resend — resend.com, free tier). Leave unset to fall back to a
# console.log stub (see lib/email.ts).
RESEND_API_KEY=""
# Optional: defaults to Resend's shared sending domain, which needs no setup
# but can only be used as-is until you verify a custom domain in Resend.
EMAIL_FROM="LockedIn <onboarding@resend.dev>"

# Image uploads (UploadThing — uploadthing.com, free tier). Required for
# proof-of-work image uploads (URL/text proof still work without it).
UPLOADTHING_TOKEN=""
